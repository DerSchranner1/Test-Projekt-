<?xml version="1.0" encoding="utf-8"?>
<!-- Nichts aus dieser App wird in ein Cloud-Backup oder auf ein anderes Gerät übertragen
     (gelernte Wörter, Zwischenablage, Schlüssel bleiben auf diesem Handy). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
