    <string name="button_start">Überwachung starten</string>
    <string name="button_stop">Überwachung stoppen</string>

    <!-- Dose card -->
    <string name="dose_title">Tagesdosis</string>
    <string name="dose_value">%1$d %%</string>
    <string name="dose_caption" formatted="false">100 % entsprechen 8 Stunden bei 85 dB(A). Je 3 dB mehr halbiert sich die Zeit.</string>

    <!-- Energy card -->
    <string name="energy_title">Akkuverbrauch (Schätzung)</string>
    <string name="energy_single">ca. %1$s %% Akku pro Tag</string>
    <string name="energy_range">ca. %1$s %% Akku pro Tag in ruhiger Umgebung, bis ca. %2$s %% bei Dauerlärm</string>
    <string name="energy_duty">Mikrofon aktiv: %1$s %% der Zeit. Dazwischen schläft das Telefon.</string>
    <string name="energy_duty_awake">Mikrofon aktiv: %1$s %% der Zeit. Bei so kurzen Abständen bleibt der Prozessor wach.</string>
    <string name="energy_disclaimer">Gerechnet mit typischen Werten für einen 4500-mAh-Akku. Der echte Verbrauch hängt vom Gerät ab und steht in den Akku-Einstellungen von Android.</string>

    <!-- Hints -->
    <string name="hint_permission_title">Mikrofon-Zugriff fehlt</string>
    <string name="hint_permission_text">Ohne Mikrofon kann die App nichts messen. Erlaube den Zugriff in den App-Einstellungen.</string>
    <string name="hint_permission_button">App-Einstellungen öffnen</string>
    <string name="hint_battery_title">Pünktlich messen, auch im Ruhezustand</string>
    <string name="hint_battery_text">Liegt das Telefon lange still, verschiebt Android die Messungen. Nimm die App von der Akku-Optimierung aus, damit sie pünktlich aufwachen darf. Sie verbraucht dadurch nicht mehr.</string>
    <string name="hint_battery_button">Ausnahme erlauben</string>
    <string name="hint_alarm_title">Telefon kann nicht schlafen</string>
    <string name="hint_alarm_text">Ohne die Berechtigung „Wecker und Erinnerungen“ muss der Prozessor zwischen den Messungen wach bleiben. Das kostet deutlich mehr Akku.</string>
    <string name="hint_alarm_button">Berechtigung erteilen</string>

    <!-- Settings -->
    <string name="section_warning">Warnung</string>
    <string name="setting_threshold">Warnen ab</string>
    <string name="setting_threshold_value">%1$d dB(A)</string>
    <string name="setting_threshold_help">Unbedenklich für höchstens %1$s pro Tag.</string>
    <string name="setting_duration">Lärm muss anhalten für</string>
    <string name="setting_cooldown">Pause zwischen zwei Warnungen</string>
    <string name="setting_vibrate">Vibrieren</string>
    <string name="setting_sound">Ton abspielen</string>
    <string name="setting_dose_warning" formatted="false">Bei 100 % Tagesdosis warnen</string>

    <string name="section_measuring">Messung und Akku</string>
    <string name="setting_interval">Abstand zwischen zwei Messungen</string>
    <string name="setting_measure">Dauer einer Messung</string>
    <string name="setting_measure_value">%1$s s</string>
    <string name="setting_adaptive">Bei Lärm öfter messen</string>
    <string name="setting_adaptive_help">Ab %1$d dB(A) wird alle %2$s gemessen statt alle %3$s. So bleibt es im Stillen sparsam und bei Lärm genau.</string>
    <string name="setting_adaptive_off_help">Der Abstand bleibt immer gleich.</string>

    <string name="section_calibration">Kalibrierung</string>
    <string name="setting_calibration">Korrektur</string>
    <string name="setting_calibration_value">%1$s dB</string>
    <string name="setting_calibration_help">Handy-Mikrofone sind nicht geeicht und weichen oft um einige dB ab. Vergleiche mit einem Schallpegelmesser oder einer Apple Watch und gleiche den Unterschied hier aus.</string>

    <string name="privacy_note">Es wird nichts aufgenommen oder gespeichert. Die App berechnet nur die Lautstärke und hat keinen Internetzugriff.</string>
</resources>
