    <string name="dose_alert_title">Tagesdosis erreicht</string>
    <string name="dose_alert_text" formatted="false">Dein Gehör hat heute 100 % der empfohlenen Lärmmenge abbekommen. Gönn ihm Ruhe.</string>
    <string name="restart_title">Lärmwächter ist aus</string>
    <string name="restart_text">Tippen, um die Überwachung wieder zu starten.</string>

    <!-- Level card -->
    <string name="level_off">Überwachung ist aus</string>
    <string name="level_waiting">Erste Messung läuft …</string>
    <string name="level_no_value">–</string>
    <string name="level_over_range">Über dem Messbereich – der echte Wert liegt höher.</string>
    <string name="level_average">Ø %1$s: %2$d dB(A)</string>
    <string name="level_instant_mode">Warnung bei einzelner lauter Messung</string>
    <string name="status_quiet">Unbedenklich</string>
    <string name="status_near">Nahe an deiner Schwelle</string>
    <string name="status_loud">Zu laut</string>
